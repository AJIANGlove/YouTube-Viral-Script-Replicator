# ===== 密钥与账号绑定（严禁入库）=====
app/config.json
app/data/video_binding.json

# ===== 运行时产物 =====
# 运行日志按约定入库（见 app/data/logs/：失败样本、留存卡批处理、探针输出）
app/data/step4_recovery/
app/data/preview-video-btn.png
app/data/preview-runs-list.png
# 任务列表索引（由 run 文件自动重建的缓存）
app/data/runs.index.json
app/data/runs.index.json.tmp
# YouTube 数据抓取的原始返回(插件 extension/ 发来,含 Studio 接口原样数据;任务文件里已留指标和曲线)
app/data/yt_analytics/
# 留存卡替换库的机器快照（程序运行时现算，不读此文件；md 版保留入库供人阅读）
assets/_library/retention_library.json

# ===== 频道声音设定（本机数据，换机器需单独拷贝）=====
app/voices/*.json
!app/voices/_template.json

# ===== 未随仓库发布的目录 =====
# 内部工作区（项目记忆、技能配置）
.workbuddy/
# SRT 质检、批处理与校验脚本
tools/
# 待拆解的新字幕
new_source/
# 外部补丁包（第三方优化方案原始材料，非本仓库产物）
claude-优化方案/

# ===== 系统与编辑器 =====
Thumbs.db
Desktop.ini
.DS_Store
node_modules/
*.log
# 例外：项目运行日志需要入库
!app/data/logs/*.log
